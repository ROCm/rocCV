#include "operators/py_op_{{OP_SNAKE}}.hpp"

#include <op_{{OP_SNAKE}}.hpp>

PyTensor PyOp{{OP_PASCAL}}::Execute(PyTensor& input{{PARAMS_PY_DECL}},
                                    std::optional<std::reference_wrapper<PyStream>> stream, eDeviceType device) {
    hipStream_t hipStream = stream.has_value() ? stream.value().get().getStream() : nullptr;
    auto inputTensor = input.getTensor();
    // NOTE: Scaffolded for operators whose output shape and dtype match the input. For shape-changing ops
    // (e.g. Resize, Crop) or dtype-changing ops (e.g. ConvertTo), pass the output shape/dtype as explicit
    // arguments and construct the output tensor accordingly — or remove this Execute overload and require
    // the caller to use ExecuteInto with a pre-allocated destination.
    auto outputTensor = std::make_shared<roccv::Tensor>(inputTensor->shape(), inputTensor->dtype(), device);
    roccv::{{OP_PASCAL}} op;
    op(hipStream, *inputTensor, *outputTensor{{PARAMS_CPP_FWD}}, device);

    return PyTensor(outputTensor);
}

void PyOp{{OP_PASCAL}}::ExecuteInto(PyTensor& output, PyTensor& input{{PARAMS_PY_DECL}},
                                    std::optional<std::reference_wrapper<PyStream>> stream, eDeviceType device) {
    hipStream_t hipStream = stream.has_value() ? stream.value().get().getStream() : nullptr;
    roccv::{{OP_PASCAL}} op;
    op(hipStream, *input.getTensor(), *output.getTensor(){{PARAMS_CPP_FWD}}, device);
}

void PyOp{{OP_PASCAL}}::Export(py::module& m) {
    using namespace py::literals;
    m.def("{{OP_PY_FUNC}}", &PyOp{{OP_PASCAL}}::Execute, "src"_a{{PARAMS_PY_DEF_ARGS}}, "stream"_a = nullptr,
          "device"_a = eDeviceType::GPU,
          R"pbdoc(

            Executes the {{OP_PASCAL}} operation on the given HIP stream.

            See also:
                Refer to the rocCV C++ API reference for more information on this operation.

            Args:
                src (rocpycv.Tensor): Input tensor containing one or more images.
{{PARAMS_PY_DOCSTRING}}
                stream (rocpycv.Stream, optional): HIP stream to run this operation on.
                device (rocpycv.Device, optional): The device to run this operation on. Defaults to GPU.

            Returns:
                rocpycv.Tensor: The output tensor.
          )pbdoc");

    m.def("{{OP_PY_FUNC}}_into", &PyOp{{OP_PASCAL}}::ExecuteInto, "dst"_a, "src"_a{{PARAMS_PY_DEF_ARGS}},
          "stream"_a = nullptr, "device"_a = eDeviceType::GPU,
          R"pbdoc(

            Executes the {{OP_PASCAL}} operation on the given HIP stream, writing into a destination tensor.

            See also:
                Refer to the rocCV C++ API reference for more information on this operation.

            Args:
                dst (rocpycv.Tensor): The destination tensor which results are written to.
                src (rocpycv.Tensor): Input tensor containing one or more images.
{{PARAMS_PY_DOCSTRING}}
                stream (rocpycv.Stream, optional): HIP stream to run this operation on.
                device (rocpycv.Device, optional): The device to run this operation on. Defaults to GPU.

            Returns:
                None
          )pbdoc");
}
